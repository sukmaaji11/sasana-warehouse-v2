{
  "name": "sasana-warehouse",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "web": "pnpm --filter @sasana/web dev",
    "mobile": "pnpm --filter @sasana/mobile start",
    "typecheck": "pnpm -r --filter=!sasana-warehouse --parallel typecheck",
    "lint": "pnpm -r --filter=!sasana-warehouse --parallel lint",
    "test": "pnpm -r --filter=!sasana-warehouse test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > packages/shared-types/src/database.types.ts",
    "bootstrap:owner": "node --env-file=.env.local scripts/bootstrap-owner.mjs"
  },
  "devDependencies": {
    "supabase": "^3.1.0",
    "typescript": "~6.0.3"
  }
}
