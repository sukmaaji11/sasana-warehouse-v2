# Salin ke .env.local. Hanya URL + publishable (anon) key.
# JANGAN pernah mengisi service role / secret key di aplikasi Android.
# Untuk HP fisik di jaringan yang sama, ganti 127.0.0.1 dengan IP LAN laptop (mis. 192.168.1.10).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
